def introspection_info(obj):
    """
    Проводит интроспекцию переданного объекта.

    :param obj: Объект для анализа.
    :return: Словарь с данными об объекте.
    """
    # Получение типа объекта
    obj_type = type(obj).__name__

    # Получение атрибутов объекта
    attributes = [attr for attr in dir(obj) if not callable(getattr(obj, attr, None)) and not attr.startswith("__")]

    # Получение методов объекта
    methods = [method for method in dir(obj) if callable(getattr(obj, method, None)) and not method.startswith("__")]

    # Получение модуля, к которому принадлежит объект
    module = getattr(obj, "__module__", "built-in")

    # Составление словаря с информацией
    info = {
        "type": obj_type,
        "attributes": attributes,
        "methods": methods,
        "module": module,
    }

    return info


# Пример использования
number_info = introspection_info(42)
print("Number Info:", number_info)

string_info = introspection_info("Hello, world!")
print("String Info:", string_info)

list_info = introspection_info([1, 2, 3])
print("List Info:", list_info)
