class Animal:
    def __init__(self, name):
        self.name = name
        self.alive = True
        self.fed = False

class Plant:
    def __init__(self, name):
        self.name = name
        self.edible = False
        self.suitable_for_predator = False

class Mammal(Animal):
    def __init__(self, name):
        super().__init__(name)

    def eat(self, food):
        if isinstance(food, Plant):
            if food.edible:
                print(f"{self.name} съел {food.name}")
                self.fed = True
            else:
                print(f"{self.name} не стал есть {food.name}")
                self.alive = False
        else:
            print("Это не еда")

# Наследник Predator (хищник) от Animal
class Predator(Animal):
    def __init__(self, name):
        super().__init__(name)

    def eat(self, food):
        if isinstance(food, Plant):
            if food.suitable_for_predator:
                print(f"{self.name} съел {food.name}")
                self.fed = True
            else:
                print(f"{self.name} съел {food.name} и отравился")
                self.alive = False
        else:
            print("Это не еда")

class Flower(Plant):
    def __init__(self, name):
        super().__init__(name)

class Fruit(Plant):
    def __init__(self, name):
        super().__init__(name)
        self.edible = True
        self.suitable_for_predator = True

class Grass(Plant):
    def __init__(self, name):
        super().__init__(name)
        self.edible = True
        self.suitable_for_predator = False

a1 = Predator('Волк с Уолл-Стрит')
a2 = Mammal('Хатико')
p1 = Flower('Цветик семицветик')
p2 = Fruit('Заводной апельсин')
p3 = Grass('Зеленая трава')

# Тестируем
print(a1.name)
print(p1.name)

print(a1.alive)
print(a2.fed)
a1.eat(p3)
a2.eat(p3)
print(a1.alive)
print(a2.fed)
