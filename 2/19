def ancient_password(n):
    result = ""
    for i in range(1, n):
        for j in range(i + 1, n):
            if n % (i + j) == 0:
                result += str(i) + str(j)
    return result

# Пример использования
try:
    n = int(input("Введите число от 3 до 20: "))
    if 3 <= n <= 20:
        print(f"Пароль для числа {n}:", ancient_password(n))
    else:
        print("Пожалуйста, введите число в пределах от 3 до 20.")
except ValueError:
    print("Ошибка ввода! Введите целое число.")
